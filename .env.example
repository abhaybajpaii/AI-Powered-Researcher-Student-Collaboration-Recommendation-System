# Environment Mode (development, testing, production)
ENVIRONMENT=development
DEBUG=true

# Database Credentials
POSTGRES_USER=collab_user
POSTGRES_PASSWORD=collab_secure_password
POSTGRES_DB=collab_matcher
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# SQLAlchemy Connection URLs
# Asyncpg driver used for FastAPI application async sessions
DATABASE_URL=postgresql+asyncpg://collab_user:collab_secure_password@localhost:5434/collab_matcher
# Sync driver used for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg://collab_user:collab_secure_password@localhost:5434/collab_matcher

# Server Settings
BACKEND_PORT=8000
SECRET_KEY=generate_a_random_32_character_secret_key_here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ML / Embedding Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Scholarly Metadata APIs (OpenAlex & Crossref)
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_MAILTO=research-admin@university.edu
OPENALEX_API_KEY=
CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_MAILTO=research-admin@university.edu
SCHOLARLY_REQUEST_TIMEOUT_SECONDS=15
